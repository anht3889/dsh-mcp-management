{
  "name": "@anht3889/dsh-mcp-mgmt-mcp",
  "description": "MCP management vocabulary for DeepSeek Harness (ctx.mcp types)",
  "version": "0.0.1",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anht3889/dsh-mcp-management.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/brand.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis"
  }
}
